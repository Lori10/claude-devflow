#!/usr/bin/env bash
# Every offline gate for this repo. CI runs this same script, so local and CI can't diverge.
# Never calls live or billed services.
#   --if-stale  skip the gates when this exact clean tree already passed (/devflow:land-branch)
#   --land      also fail while the branch's OpenSpec change is not archived yet
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

cfg() { sed -n "s/^DEVFLOW_$1=//p" .claude/devflow.env 2>/dev/null | tail -1 | sed "s/^[\"']//; s/[\"']\$//"; }
PROTECTED=$(cfg PROTECTED_BRANCH); PROTECTED=${PROTECTED:-main}
OPENSPEC_VERSION=$(cfg OPENSPEC_VERSION)
TEST_PATHS=$(cfg TEST_PATHS); TEST_PATHS=${TEST_PATHS:-tests}
SERVICES=$(cfg SERVICES)

if_stale=0; land=0
for arg in "$@"; do
  case "$arg" in
    --if-stale) if_stale=1 ;;
    --land) land=1 ;;
    *) echo "unknown option: $arg" >&2; exit 2 ;;
  esac
done

fail=0
branch=$(git branch --show-current)
base=$(git merge-base "origin/$PROTECTED" HEAD 2>/dev/null || git merge-base "$PROTECTED" HEAD 2>/dev/null || true)

if [[ $land -eq 1 ]]; then
  change="${branch#*/}"
  echo "=== land preflight"
  if [[ "$branch" == "$PROTECTED" ]]; then
    echo "On $PROTECTED: nothing to land."; echo "--> FAIL"; exit 1
  elif [[ -d "openspec/changes/$change" ]]; then
    echo "openspec/changes/$change is not archived: run /opsx:archive $change and commit first."
    echo "--> FAIL"; exit 1
  fi
  # The archived change must be finished, live-check tasks included (the user runs or approves them).
  # Archive folders are YYYY-MM-DD-<name>; match the date exactly so "x" can't match "add-x".
  archived=$(ls -d openspec/changes/archive/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-"$change" 2>/dev/null | sort | tail -1)
  if [[ -n "$archived" && -f "$archived/tasks.md" ]] && grep -nE '^\s*- \[ \]' "$archived/tasks.md"; then
    echo "$archived/tasks.md still has unchecked tasks (above): finish them or get the user's explicit OK."
    echo "--> FAIL"; exit 1
  fi
  echo "--> PASS"
fi

# A full pass on a clean tree stamps HEAD's tree hash; uncommitted work never gets a stamp.
stamp="$(git rev-parse --git-dir)/verify-pass"
tree=""
[[ -z "$(git status --porcelain)" ]] && tree=$(git rev-parse 'HEAD^{tree}')
if [[ $if_stale -eq 1 && -n "$tree" && "$(cat "$stamp" 2>/dev/null)" == "$tree" ]]; then
  echo "=== already verified: tree $tree passed every gate; nothing changed since"
  exit 0
fi
rm -f "$stamp"

gate() {
  local name=$1; shift
  echo "=== $name"
  if out=$("$@" 2>&1); then echo "$out" | tail -3; echo "--> PASS"
  else echo "$out" | tail -40; echo "--> FAIL"; fail=1; fi
}

services_up=1
for svc in $SERVICES; do
  if ! (exec 3<>"/dev/tcp/${svc%:*}/${svc##*:}") 2>/dev/null; then
    echo "=== service $svc is not reachable; start it before running the tests"; services_up=0
  fi
done
{% if lint_cmd %}
gate "lint" {{ lint_cmd }}
{% endif %}{% if test_cmd %}
if [[ $services_up -eq 1 ]]; then
  gate "tests" {{ test_cmd }}
else
  echo "=== tests"; echo "--> FAIL (required services down)"; fail=1
fi
{% endif %}
if [[ -n "$OPENSPEC_VERSION" ]]; then
  gate "openspec validate" npx --yes "@fission-ai/openspec@$OPENSPEC_VERSION" validate --all --strict
fi

if command -v gitleaks >/dev/null 2>&1; then
  if [[ -n "$base" ]]; then
    gate "secrets (gitleaks, branch commits)" gitleaks git --no-banner --redact --log-opts="$base..HEAD" .
  fi
elif [[ -z "${GITHUB_ACTIONS:-}" ]]; then
  echo "=== secrets: gitleaks not installed locally (CI runs it); install it for a local scan"
fi

echo "=== weakened-test scan (vs ${base:0:12})"
suspects=0
if [[ -n "$base" ]]; then
  # shellcheck disable=SC2086
  scripts/weakened_tests.py --base "$base" $TEST_PATHS || suspects=1
else
  echo "no merge base with $PROTECTED; skipped"
fi

# A pass with test hunks still to review isn't stamped: /devflow:verify has to read them first.
[[ $fail -eq 0 && $suspects -eq 0 && -n "$tree" ]] && echo "$tree" > "$stamp"
exit $fail
