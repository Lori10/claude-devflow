# devflow plugin configuration (read by the hooks and scripts/check.sh; parsed, never executed).
# Editing this file asks for confirmation inside Claude Code: it controls the guardrails.
DEVFLOW_PROTECTED_BRANCH={{ protected_branch }}
DEVFLOW_OPENSPEC_VERSION={{ openspec_version }}
DEVFLOW_CHECK_CMD=scripts/check.sh
DEVFLOW_FAST_TEST_CMD={{ fast_test_cmd }}
DEVFLOW_CODE_PATHS={{ code_paths }}
DEVFLOW_TEST_PATHS={{ test_paths }}
DEVFLOW_LINT_CMD={{ lint_file_cmd }}
DEVFLOW_LINT_GLOBS={{ lint_globs }}
DEVFLOW_SERVICES={{ services }}
DEVFLOW_PUBLIC_REPO={{ public_repo | lower }}
DEVFLOW_CLOUD={{ '' if cloud == 'none' else cloud }}
DEVFLOW_AWS_REGION={{ aws_region | default('') }}
DEVFLOW_STOP_TIMEOUT=300
