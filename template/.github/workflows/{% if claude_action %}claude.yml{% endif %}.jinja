name: Claude

# Answers "@claude ..." in issue and PR comments. The action itself only responds to users
# with write access; the author_association filter also keeps strangers' comments from
# starting a runner at all. Setup: /install-github-app (sets ANTHROPIC_API_KEY).
on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  claude:
{%- raw %}
    if: >-
      contains(github.event.comment.body, '@claude') &&
      contains(fromJSON('["OWNER","MEMBER","COLLABORATOR"]'), github.event.comment.author_association)
{%- endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    permissions:
      contents: write
      pull-requests: write
      issues: write
      id-token: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          fetch-depth: 0
      - uses: anthropics/claude-code-action@d70510b174a1244958df0b03166a54912811f3e6 # v1.0.264
        with:
{%- raw %}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
{%- endraw %}
          trigger_phrase: "@claude"
          claude_args: "--max-turns 5"
